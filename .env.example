# Copy to .env.local for local development. Never commit real secrets.
# The web app reads VITE_API_URL at build time; leave it empty to use the
# Vite dev proxy (/api -> http://localhost:8787).

# API base URL for the web app, e.g. https://bill-splitter-api.<subdomain>.workers.dev
VITE_API_URL=

# Cloudflare deploy credentials. These are CI-only: set them as GitHub
# repository secrets (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID), never
# in this file.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
